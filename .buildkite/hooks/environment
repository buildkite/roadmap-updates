#!/bin/bash

# Set Hosted Models credentials BEFORE the plugin's environment hook reads them.
#
# Hook order: agent env → repo env (this) → plugin env
#
# The Buildkite agent sets BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY from YAML
# config before hooks run. We override it here with the real token. When the
# plugin's environment hook then reads it via plugin_read_config, it gets our value.

if [[ -n "${BUILDKITE_AGENT_ACCESS_TOKEN:-}" && -n "${BUILDKITE_AGENT_ENDPOINT:-}" ]]; then
  export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="$BUILDKITE_AGENT_ACCESS_TOKEN"
  export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_ANTHROPIC_BASE_URL="$BUILDKITE_AGENT_ENDPOINT/ai/anthropic"
  export ANTHROPIC_API_KEY="$BUILDKITE_AGENT_ACCESS_TOKEN"
  export ANTHROPIC_BASE_URL="$BUILDKITE_AGENT_ENDPOINT/ai/anthropic"
fi
