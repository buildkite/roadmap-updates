#!/bin/bash

# Configure Claude API access for both the claude-summarize plugin and
# general scripts (e.g., model providers demo).
#
# The plugin's post-command hook runs a connectivity pre-check:
#   curl -s --max-time 5 "${base_url}/v1/ping"
# which fails against the hosted models proxy (no unauthenticated ping).
# So we use the direct Anthropic API key from secrets for the plugin,
# and set up hosted models env vars separately for other scripts.

# Plugin: use direct Anthropic API key (ping check passes against api.anthropic.com)
KEY=$(buildkite-agent secret get ANTHROPIC_API_KEY 2>/dev/null || true)
if [[ -n "$KEY" ]]; then
  export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="$KEY"
fi

# Other scripts: set up hosted models access
if [[ -n "${BUILDKITE_AGENT_ACCESS_TOKEN:-}" && -n "${BUILDKITE_AGENT_ENDPOINT:-}" ]]; then
  export ANTHROPIC_API_KEY="$BUILDKITE_AGENT_ACCESS_TOKEN"
  export ANTHROPIC_BASE_URL="$BUILDKITE_AGENT_ENDPOINT/ai/anthropic"
fi
