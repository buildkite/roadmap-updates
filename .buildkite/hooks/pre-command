#!/bin/bash

# Set hosted models env vars for scripts.
if [[ -n "${BUILDKITE_AGENT_ACCESS_TOKEN:-}" && -n "${BUILDKITE_AGENT_ENDPOINT:-}" ]]; then
  export ANTHROPIC_API_KEY="$BUILDKITE_AGENT_ACCESS_TOKEN"
  export ANTHROPIC_BASE_URL="$BUILDKITE_AGENT_ENDPOINT/ai/anthropic"
fi

# Wrap the claude-summarize plugin's post-command hook to inject the
# job-scoped access token at runtime.
#
# Why this is needed:
# - The Buildkite agent re-injects BUILDKITE_PLUGIN_* env vars from YAML
#   config before each plugin hook, clobbering any overrides.
# - $$VAR in YAML becomes literal "$VAR" — never expanded by the plugin.
# - $VAR in YAML is expanded at upload time, but BUILDKITE_AGENT_ACCESS_TOKEN
#   is job-scoped, so the upload step's token is invalid for other jobs.
# - This wrapper overrides the env vars right before the original hook runs.
PLUGIN_PC=$(find /buildkite/plugins -path "*claude-summarize*" -name "post-command" 2>/dev/null | head -1)
if [[ -n "$PLUGIN_PC" && ! -f "${PLUGIN_PC}.orig" ]]; then
  cp "$PLUGIN_PC" "${PLUGIN_PC}.orig"
  cat > "$PLUGIN_PC" << 'WRAPPER'
#!/bin/bash
# Inject job-scoped hosted models credentials
export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="$BUILDKITE_AGENT_ACCESS_TOKEN"
export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_ANTHROPIC_BASE_URL="$BUILDKITE_AGENT_ENDPOINT/ai/anthropic"
exec "$(dirname "$0")/post-command.orig" "$@"
WRAPPER
  chmod +x "$PLUGIN_PC"
fi
