#!/bin/bash

# Fetch ANTHROPIC_API_KEY from Buildkite Secrets for both scripts and plugin.
if command -v buildkite-agent &>/dev/null; then
  ANTHROPIC_API_KEY="$(buildkite-agent secret get ANTHROPIC_API_KEY 2>/dev/null || true)"
  if [[ -n "$ANTHROPIC_API_KEY" ]]; then
    export ANTHROPIC_API_KEY
  fi
fi

# Fall back to hosted models env vars for scripts if no secret is available.
if [[ -z "${ANTHROPIC_API_KEY:-}" && -n "${BUILDKITE_AGENT_ACCESS_TOKEN:-}" && -n "${BUILDKITE_AGENT_ENDPOINT:-}" ]]; then
  export ANTHROPIC_API_KEY="$BUILDKITE_AGENT_ACCESS_TOKEN"
  export ANTHROPIC_BASE_URL="$BUILDKITE_AGENT_ENDPOINT/ai/anthropic"
fi
