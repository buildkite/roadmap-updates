#!/bin/bash

# Fetch ANTHROPIC_API_KEY from Buildkite Secrets for both scripts and plugin.
if command -v buildkite-agent &>/dev/null; then
  ANTHROPIC_API_KEY="$(buildkite-agent secret get ANTHROPIC_API_KEY 2>/dev/null || true)"
  if [[ -n "$ANTHROPIC_API_KEY" ]]; then
    export ANTHROPIC_API_KEY
  fi
fi

# Fall back to hosted models env vars for scripts if no secret is available.
if [[ -z "${ANTHROPIC_API_KEY:-}" && -n "${BUILDKITE_AGENT_ACCESS_TOKEN:-}" && -n "${BUILDKITE_AGENT_ENDPOINT:-}" ]]; then
  export ANTHROPIC_API_KEY="$BUILDKITE_AGENT_ACCESS_TOKEN"
  export ANTHROPIC_BASE_URL="$BUILDKITE_AGENT_ENDPOINT/ai/anthropic"
fi

# Wrap the claude-summarize plugin's post-command hook to inject the
# ANTHROPIC_API_KEY at runtime (the agent re-injects literal YAML values
# before each plugin hook, so env vars need to be set right before exec).
for search_dir in /buildkite/plugins .buildkite/plugins; do
  PLUGIN_PC=$(find "$search_dir" -path "*claude-summarize*" -name "post-command" 2>/dev/null | head -1)
  [[ -n "$PLUGIN_PC" ]] && break
done
if [[ -n "${PLUGIN_PC:-}" && ! -f "${PLUGIN_PC}.orig" ]]; then
  ORIG="${PLUGIN_PC}.orig"
  cp "$PLUGIN_PC" "$ORIG"
  cat > "$PLUGIN_PC" << EOF
#!/bin/bash
export BUILDKITE_PLUGIN_CLAUDE_SUMMARIZE_API_KEY="\$ANTHROPIC_API_KEY"
exec "$ORIG" "\$@"
EOF
  chmod +x "$PLUGIN_PC"
fi
